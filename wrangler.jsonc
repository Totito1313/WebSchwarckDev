{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webschwarckdev",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  // El sitio son archivos estáticos; el Worker solo atiende /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "build": {
    "command": "npm run build"
  },
  // Novedades y reseñas. Sin `id`: wrangler crea el espacio al desplegar.
  "kv_namespaces": [
    { "binding": "SITE" }
  ],
  // Frenos de ráfagas por visitante: entradas al panel y envíos de reseñas.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 4, "period": 60 } }
  ]
}
