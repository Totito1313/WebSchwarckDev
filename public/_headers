# Cabeceras de los archivos estáticos (las aplica Cloudflare).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite pone una huella en el nombre de cada archivo: se pueden guardar para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# La página que abre el cliente con un enlace: ni se guarda en caché ni se indexa.
/documento/*
  Cache-Control: no-store
  X-Robots-Tag: noindex
  Referrer-Policy: no-referrer
